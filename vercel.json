{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/login",
      "destination": "/api/index.py"
    },
    {
      "source": "/snapshot",
      "destination": "/api/index.py"
    },
    {
      "source": "/ws",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|login|snapshot|ws).*)",
      "destination": "/$1"
    }
  ]
}
